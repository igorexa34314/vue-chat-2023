{
	"name": "vue-chat-2023",
	"description": "My first chat based on Vue 3 and Firebase SDK",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p typecheck \"build-only {@}\" --",
		"preview": "vite preview",
		"build-only": "vite build",
		"typecheck": "vue-tsc --build",
		"analyze": "vite build --mode=analyze",
		"lint": "eslint . --cache",
		"lint:fix": "eslint . --fix --cache",
		"format": "prettier --write --cache src/"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@unhead/vue": "1.11.19",
		"@vueuse/core": "^12.7.0",
		"algoliasearch": "^5.20.3",
		"base64-arraybuffer": "^1.0.2",
		"firebase": "^11.3.1",
		"pinia": "^3.0.1",
		"uuid": "^11.0.5",
		"vue": "^3.5.13",
		"vue-i18n": "^11.1.1",
		"vue-instantsearch": "^4.20.4",
		"vue-router": "^4.5.0",
		"vuetify": "^3.7.12",
		"vuetify-birthdaypicker": "^0.0.3"
	},
	"devDependencies": {
		"@intlify/unplugin-vue-i18n": "^6.0.3",
		"@tsconfig/node20": "^20.1.4",
		"@types/node": "^20.17.19",
		"@types/uuid": "^10.0.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.4.0",
		"@vue/tsconfig": "^0.7.0",
		"eslint": "^9.20.1",
		"eslint-plugin-vue": "^9.32.0",
		"jiti": "^2.4.2",
		"npm-run-all2": "^7.0.2",
		"prettier": "^3.5.1",
		"rollup-plugin-visualizer": "^5.14.0",
		"sass-embedded": "^1.85.0",
		"typescript": "^5.7.3",
		"unplugin-vue-router": "^0.11.2",
		"vite": "^6.1.0",
		"vite-plugin-vue-devtools": "^7.7.2",
		"vite-plugin-vuetify": "^2.1.0",
		"vue-tsc": "^2.2.2"
	},
	"packageManager": "pnpm@9.15.4",
	"repository": {
		"type": "git",
		"url": "https://github.com/igorexa34314/vue-chat-2023.git"
	}
}
